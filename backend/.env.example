# Configuração do banco de dados PostgreSQL
# Você pode usar DATABASE_URL completa OU as variáveis separadas abaixo.

# DATABASE_URL=postgres://usuario:senha@localhost:5432/transporte?sslmode=disable

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=transporte
DB_SSLMODE=disable

# Segredo para assinar tokens JWT
JWT_SECRET=altere-para-um-segredo-forte

# Porta do servidor
PORT=8080
